# Telegram Bot Token (@BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Chat ID (npm run get-chat-id)
TELEGRAM_CHAT_ID=your_chat_id_here

# Secret for manual GET /run?secret=...
MANUAL_TRIGGER_SECRET=change-me

# Seen state file (on Railway mount Volume at /data and use this path)
SEEN_FILE=./seen_vacancies.json

# DOU RSS search query
DOU_SEARCH=React

# Notify only vacancies dated today in Europe/Kyiv (false = any unseen item in the feed)
ONLY_TODAY=true

# How often the server polls DOU
CHECK_INTERVAL_MINUTES=5

# How many successfully sent vacancies to remember. Pending deliveries are kept aside from this cap.
MAX_SEEN=100
